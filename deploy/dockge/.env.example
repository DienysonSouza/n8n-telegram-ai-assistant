# Ambiente do stack no Dockge.
#
# No Dockge, cole este conteudo na aba de ambiente (.env) do stack e preencha
# os campos vazios. NAO comite este arquivo preenchido e NAO tire print da
# tela com os valores visiveis.
#
# Gere PG_PASSWORD e N8N_ENCRYPTION_KEY com:
#   openssl rand -hex 24    # PG_PASSWORD
#   openssl rand -hex 32    # N8N_ENCRYPTION_KEY
# ou rode scripts/gen-secrets.sh (Linux/macOS) / scripts/gen-secrets.ps1.

# --- Obrigatorios: sem estes o deploy falha de proposito ---
TELEGRAM_BOT_TOKEN=
ANTHROPIC_API_KEY=
OWNER_CHAT_ID=
OWNER_NAME=
PG_PASSWORD=
N8N_ENCRYPTION_KEY=

# --- Identidade do assistente ---
BOT_NAME=Assistente
SECONDARY_NAME=

# --- Banco (mantenha PG_HOST=postgres: e o nome do servico no stack) ---
PG_HOST=postgres
PG_PORT=5432
PG_DATABASE=assistant
PG_USER=assistant

# --- Rede e URL publica ---
# Para uso local deixe como esta. Para VPS com dominio proprio, use:
#   N8N_HOST=bot.exemplo.com
#   N8N_PROTOCOL=https
#   N8N_SECURE_COOKIE=true
#   WEBHOOK_URL=https://bot.exemplo.com/
# Com proxy reverso no mesmo host, prefira N8N_PORT=127.0.0.1:5678
# para nao expor o n8n direto na internet.
N8N_PORT=5678
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_SECURE_COOKIE=false
WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=America/Sao_Paulo
TZ=America/Sao_Paulo

# --- Versao da imagem e retencao de execucoes ---
# Em producao, troque "latest" por uma tag fixa (ex.: v1.0.0).
ASSISTANT_VERSION=latest
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
EXECUTIONS_DATA_MAX_AGE=168
EXECUTIONS_DATA_PRUNE_MAX_COUNT=1000

# --- Opcionais ---
# Consulta processual (DataJud) no workflow Pro.
CNJ_API_KEY=
# Token de um Cloudflare Tunnel ja criado na sua conta. So e usado se voce
# descomentar o servico cloudflared no compose.yaml.
CLOUDFLARE_TUNNEL_TOKEN=
