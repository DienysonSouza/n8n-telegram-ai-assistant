# Copie para .env e preencha somente os valores marcados.
# Nunca publique o .env.

# Obrigatorios
TELEGRAM_BOT_TOKEN=
ANTHROPIC_API_KEY=
OWNER_CHAT_ID=
OWNER_NAME=
BOT_NAME=Assistente
PG_PASSWORD=
N8N_ENCRYPTION_KEY=

# Banco funcional
PG_HOST=postgres
PG_PORT=5432
PG_DATABASE=assistant
PG_USER=assistant

# n8n e URL publica
N8N_PORT=5678
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_SECURE_COOKIE=false
WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=America/Sao_Paulo
TZ=America/Sao_Paulo

# Versoes e retencao
ASSISTANT_VERSION=latest
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
EXECUTIONS_DATA_MAX_AGE=168
EXECUTIONS_DATA_PRUNE_MAX_COUNT=1000

# Personalizacao
SECONDARY_NAME=

# Workflow Pro: consulta processual opcional
CNJ_API_KEY=

# Opcional: Cloudflare Tunnel gerenciado pelo usuario
CLOUDFLARE_TUNNEL_TOKEN=
