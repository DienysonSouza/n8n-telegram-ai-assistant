# ============================================================
#  n8n Telegram AI Assistant — configuração
#  Copie para .env e preencha com os SEUS valores.
#  NUNCA versione o .env (já está no .gitignore).
# ============================================================

# ─── Telegram ───────────────────────────────────────────────
# Token do seu bot (crie em https://t.me/BotFather → /newbot).
# Use-o na credential "Telegram API" do n8n (não é lido por env).
TELEGRAM_BOT_TOKEN=
# Seu chat id (descubra em https://t.me/userinfobot).
# É o "gate de dono": só esse id comanda o bot e recebe os avisos.
OWNER_CHAT_ID=
# Nome usado nos prompts/saudações (substitui o nome próprio original)
OWNER_NAME=Alex
# (Opcional) nome de uma 2ª pessoa/parceiro(a) que o bot reconhece
SECONDARY_NAME=

# ─── IA (Anthropic Claude) ──────────────────────────────────
# Use a chave na credential "Anthropic" do n8n.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ─── Banco de dados (Postgres) ──────────────────────────────
PG_HOST=postgres
PG_PORT=5432
PG_DATABASE=assistant
PG_USER=assistant
# troque por uma senha forte
PG_PASSWORD=change-me-strong-password

# ─── n8n ────────────────────────────────────────────────────
# Gere uma chave forte (ex.: openssl rand -hex 24) e GUARDE OFFLINE.
# Sem ela, as credenciais salvas no n8n viram lixo.
N8N_ENCRYPTION_KEY=
GENERIC_TIMEZONE=America/Sao_Paulo
TZ=America/Sao_Paulo

# ─── Financeiro ─────────────────────────────────────────────
EXPENSE_CATEGORIES=alimentacao,transporte,saude,lazer,moradia,contas,educacao,outros

# ─── Módulo Jurídico (opcional) ─────────────────────────────
ENABLE_JURIDICO=false
# chave pública da API Comunica/DataJud do CNJ
CNJ_API_KEY=
OAB_NUMBER=

# ─── Módulo Fitness (opcional) ──────────────────────────────
ENABLE_FITNESS=false
